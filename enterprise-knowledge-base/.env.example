# ==========================================
# 应用基础配置
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 云端 PostgreSQL + pgvector 配置 (如 Supabase / Neon)
# ==========================================
POSTGRES_HOST=your-supabase-host.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_project_id
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=postgres
POSTGRES_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# ==========================================
# 云端 MongoDB 配置 (如 MongoDB Atlas)
# ==========================================
MONGODB_USERNAME=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/knowledge_hub?retryWrites=true&w=majority
MONGODB_DB=knowledge_hub


# ==========================================
# 云端 AI / 大模型服务 API 配置 (选填)
# ==========================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
