# ==========================================
# 应用基础配置
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 云端 PostgreSQL + pgvector 配置 (来自 Supabase)
# ==========================================
POSTGRES_HOST=your-supabase-host.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=your-supabase-user
POSTGRES_PASSWORD=your-supabase-password
POSTGRES_DB=postgres
POSTGRES_URL=postgresql://your-user:your-password@your-host.pooler.supabase.com:5432/postgres

# ==========================================
# 云端 MongoDB 配置 (MongoDB Atlas)
# ==========================================
MONGODB_USERNAME=your-mongodb-username
MONGODB_PASSWORD=your-mongodb-password
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/knowledge_hub?retryWrites=true&w=majority
MONGODB_DB=knowledge_hub

# ==========================================
# 云端 AI / 大模型服务 API 配置 (来自 阿里云百炼)
# ==========================================
ALIYUN_API_KEY=your-aliyun-api-key
OPENAI_BASE_URL=https://ws-zltje74rc65q4wpd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3.6-plus
OPENAI_EMBEDDING_NAME=text-embedding-v4

# ==========================================
# Cloudflare R2 对象存储配置
# ==========================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=my-images
R2_PUBLIC_DOMAIN=https://image-dev.example.com

# ==========================================
# CloudAMQP (RabbitMQ) 消息队列配置
# ==========================================
RABBITMQ_URL=amqps://your-user:your-password@fuji.lmq.cloudamqp.com/your-vhost

# ==========================================
# Axiom 云端日志服务配置 (可选)
# ==========================================
AXIOM_DATASET=knowledge-base-logs
AXIOM_TOKEN=your-axiom-token

# ==========================================
# LangChain / LangSmith 链路追踪配置 (smith.langchain.com)
# ==========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key
LANGCHAIN_PROJECT=enterprise-knowledge-base

# ==========================================
# Langfuse 可观测性与链路追踪配置 (cloud.langfuse.com 或自建)
# ==========================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com


